{% comment %}
  App embed block da precificação regional.

  Carregado em todas as páginas da loja. Faz três coisas, nesta ordem:
  1. Injeta o CSS que esconde os preços ANTES de o tema pintar a tela
     (evita o flash do preço base — Etapa 6.2).
  2. Publica a configuração da loja em window.__REGIONAL_PRICING__.
  3. Carrega o script que resolve a região e aplica os preços.
{% endcomment %}

<style>
  /*
    O tema renderiza o preço base antes de o JS rodar. Sem isso o cliente vê o
    preço errado por alguns milissegundos. A classe é removida pelo script
    assim que os preços regionais entram — ou pelo timeout de segurança.
  */
  html.rp-prices-hidden .price,
  html.rp-prices-hidden .price__container,
  html.rp-prices-hidden .price-item,
  html.rp-prices-hidden [data-rp-price],
  html.rp-prices-hidden .product__price,
  html.rp-prices-hidden .money {
    visibility: hidden !important;
  }

  /*
    A option "Região" existe tecnicamente no produto, então o tema desenha um
    seletor de variante. O cliente não escolhe região ali — só pelo pop-up e
    pelo badge (Etapa 6.3).
  */
  {% if block.settings.hide_variant_picker %}
    variant-selects,
    variant-radios,
    .product-form__input--pill,
    .product-form__input--dropdown,
    .product-variant-picker,
    [data-rp-hide-variant] {
      display: none !important;
    }
  {% endif %}
</style>

<script>
  document.documentElement.classList.add('rp-prices-hidden');

  window.__REGIONAL_PRICING__ = {
    proxyBase: {{ block.settings.proxy_base | default: '/apps/regional-pricing' | json }},
    badgeEnabled: {{ block.settings.show_badge | json }},
    badgeSelector: {{ block.settings.badge_selector | default: '' | json }},
    priceSelectors: {{ block.settings.price_selectors | default: '' | json }},
    revealTimeoutMs: {{ block.settings.reveal_timeout | default: 2000 | json }},
    cartAttributeName: {{ block.settings.cart_attribute | default: 'Região' | json }},
    moneyFormat: {{ shop.money_format | json }},
    templateName: {{ template.name | json }},
    productId: {% if product %}{{ product.id | json }}{% else %}null{% endif %},
    productHandle: {% if product %}{{ product.handle | json }}{% else %}null{% endif %},
    debug: {{ block.settings.debug | json }}
  };
</script>

<link
  rel="stylesheet"
  href="{{ 'regional-pricing.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>
<script src="{{ 'regional-pricing.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Precificação Regional",
  "target": "head",
  "settings": [
    {
      "type": "text",
      "id": "proxy_base",
      "label": "Caminho do App Proxy",
      "default": "/apps/regional-pricing",
      "info": "Precisa bater com o subpath configurado no Shopify Partners."
    },
    {
      "type": "checkbox",
      "id": "hide_variant_picker",
      "label": "Ocultar o seletor de variante nas páginas de produto",
      "default": true,
      "info": "A opção Região é um detalhe técnico: o cliente escolhe pelo pop-up."
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Mostrar o badge da região ativa",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_selector",
      "label": "Onde encaixar o badge (seletor CSS)",
      "info": "Deixe em branco para o badge flutuar no canto da tela."
    },
    {
      "type": "textarea",
      "id": "price_selectors",
      "label": "Seletores extras de preço",
      "info": "Um por linha. Use se o seu tema renderizar o preço fora dos seletores padrão."
    },
    {
      "type": "text",
      "id": "cart_attribute",
      "label": "Nome do atributo de carrinho com a região",
      "default": "Região"
    },
    {
      "type": "range",
      "id": "reveal_timeout",
      "label": "Timeout de segurança para revelar os preços (ms)",
      "min": 500,
      "max": 5000,
      "step": 250,
      "default": 2000,
      "info": "Se o app não responder nesse tempo, os preços aparecem mesmo assim."
    },
    {
      "type": "checkbox",
      "id": "debug",
      "label": "Registrar logs no console do navegador",
      "default": false
    }
  ]
}
{% endschema %}
