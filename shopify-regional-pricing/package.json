{
  "name": "shopify-regional-pricing",
  "version": "1.0.0",
  "private": true,
  "description": "App Shopify custom de precificacao regional via variante por regiao",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json && npm run build:web",
    "build:server": "npm run prisma:generate && tsc -p tsconfig.json",
    "build:web": "npm --prefix web ci --no-audit --no-fund && npm --prefix web run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.3",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.1",
    "pino": "9.14.0",
    "prisma": "6.19.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
