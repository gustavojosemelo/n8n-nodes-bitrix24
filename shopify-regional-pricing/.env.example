# ---------------------------------------------------------------------------
# Credenciais do app (Shopify Partners > Apps > seu app custom)
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# URL publica do app (a mesma configurada no Partners). Sem barra no final.
SHOPIFY_APP_URL=https://app.seudominio.com.br
SHOPIFY_SCOPES=read_products,write_products,read_orders
# Versao da Admin API usada nas chamadas GraphQL.
SHOPIFY_API_VERSION=2025-10
# Dominio da loja custom. Restringe a instalacao a essa loja (recomendado).
SHOPIFY_SHOP_DOMAIN=minhaloja.myshopify.com

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/regional_pricing?schema=public

# ---------------------------------------------------------------------------
# Seguranca
# ---------------------------------------------------------------------------
# 32 bytes em hex (64 chars). Gere com: openssl rand -hex 32
ENCRYPTION_KEY=
# Segredo para assinar cookies de estado do OAuth. openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Sync / fila
# ---------------------------------------------------------------------------
# Quantos produtos sao processados em paralelo por job. Suba com cuidado:
# a Admin API tem rate limit por custo.
SYNC_CONCURRENCY=2
# Intervalo (ms) com que o worker procura jobs na fila.
SYNC_POLL_INTERVAL_MS=2000
# TTL do cache do endpoint /proxy/prices (segundos).
PRICE_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Desenvolvimento local (NUNCA ligar em producao)
# ---------------------------------------------------------------------------
# Permite chamar a API do admin com o header x-dev-shop em vez do JWT do
# App Bridge, e desliga a validacao de assinatura do App Proxy.
ALLOW_DEV_AUTH=false
